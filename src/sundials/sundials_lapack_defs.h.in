#ifndef SUNDIALS_LAPACK_DEFS_H_IN
#define SUNDIALS_LAPACK_DEFS_H_IN

#include <sundials/sundials_types.h>

#ifdef __cplusplus /* wrapper to enable C++ usage */
extern "C" {
#endif

/* Define LAPACK name-mangling macros. Depending on the inferred scheme, one of
 * the following six macros will be defined:
 *
 * #define SUNDIALS_LAPACK_FUNC(name,NAME) name
 * #define SUNDIALS_LAPACK_FUNC(name,NAME) name ## _
 * #define SUNDIALS_LAPACK_FUNC(name,NAME) name ## __
 * #define SUNDIALS_LAPACK_FUNC(name,NAME) NAME
 * #define SUNDIALS_LAPACK_FUNC(name,NAME) NAME ## _
 * #define SUNDIALS_LAPACK_FUNC(name,NAME) NAME ## __
 */
@LAPACK_MANGLE_MACRO1@

/* Define LAPACK name-mangling macro for C identifiers
 * which contain underscores.
 */
@LAPACK_MANGLE_MACRO2@

/* LAPACK's integer ABI can differ from the installed SUNDIALS index ABI. */
#define SUNDIALS_LAPACK_INT_BYTES @SUNDIALS_LAPACK_INT_BYTES@
#if SUNDIALS_LAPACK_INT_BYTES == 4 && defined(SUNDIALS_INT64_T)
typedef int32_t sunlapackinttype;
#define SUNDIALS_LAPACK_CONVERT_PIVOTS 1
#elif SUNDIALS_LAPACK_INT_BYTES == 8 && defined(SUNDIALS_INT32_T)
typedef int64_t sunlapackinttype;
#define SUNDIALS_LAPACK_CONVERT_PIVOTS 1
#else
typedef sunindextype sunlapackinttype;
#define SUNDIALS_LAPACK_CONVERT_PIVOTS 0
#endif

/* Largest common index precision as an exclusive bound for workspace queries.
 * The power of two is exactly representable even in single precision. */
#if SUNDIALS_LAPACK_INT_BYTES == 4 || defined(SUNDIALS_INT32_T)
#define SUNDIALS_LAPACK_LWORK_LIMIT SUN_RCONST(2147483648.0)
#else
#define SUNDIALS_LAPACK_LWORK_LIMIT SUN_RCONST(9223372036854775808.0)
#endif

static inline sunbooleantype sunLapackIndexInRange(sunindextype index)
{
#if SUNDIALS_LAPACK_INT_BYTES == 4 && defined(SUNDIALS_INT64_T)
  return index >= 0 && index <= INT32_MAX;
#else
  return index >= 0;
#endif
}

/*
 * ==================================================================
 * Blas and Lapack functions
 * ==================================================================
 */

#if defined(SUNDIALS_LAPACK_FUNC)

#define dgbtrf_f77 SUNDIALS_LAPACK_FUNC(dgbtrf, DGBTRF)
#define dgbtrs_f77 SUNDIALS_LAPACK_FUNC(dgbtrs, DGBTRS)
#define dgetrf_f77 SUNDIALS_LAPACK_FUNC(dgetrf, DGETRF)
#define dgetrs_f77 SUNDIALS_LAPACK_FUNC(dgetrs, DGETRS)
#define dgeev_f77  SUNDIALS_LAPACK_FUNC(dgeev, DGEEV)

#define sgbtrf_f77 SUNDIALS_LAPACK_FUNC(sgbtrf, SGBTRF)
#define sgbtrs_f77 SUNDIALS_LAPACK_FUNC(sgbtrs, SGBTRS)
#define sgetrf_f77 SUNDIALS_LAPACK_FUNC(sgetrf, SGETRF)
#define sgetrs_f77 SUNDIALS_LAPACK_FUNC(sgetrs, SGETRS)
#define sgeev_f77  SUNDIALS_LAPACK_FUNC(sgeev, SGEEV)

#else

#define dgbtrf_f77 dgbtrf_
#define dgbtrs_f77 dgbtrs_
#define dgetrf_f77 dgetrf_
#define dgetrs_f77 dgetrs_
#define dgeev_f77  dgeev_

#define sgbtrf_f77 sgbtrf_
#define sgbtrs_f77 sgbtrs_
#define sgetrf_f77 sgetrf_
#define sgetrs_f77 sgetrs_
#define sgeev_f77  sgeev_

#endif

/* LAPACK */

extern void dgbtrf_f77(const sunlapackinttype* m, const sunlapackinttype* n,
                       const sunlapackinttype* kl, const sunlapackinttype* ku,
                       double* ab, sunlapackinttype* ldab, sunlapackinttype* ipiv,
                       sunlapackinttype* info);

extern void dgbtrs_f77(const char* trans, const sunlapackinttype* n,
                       const sunlapackinttype* kl, const sunlapackinttype* ku,
                       const sunlapackinttype* nrhs, double* ab,
                       const sunlapackinttype* ldab, sunlapackinttype* ipiv, double* b,
                       const sunlapackinttype* ldb, sunlapackinttype* info);

extern void dgetrf_f77(const sunlapackinttype* m, const sunlapackinttype* n, double* a,
                       sunlapackinttype* lda, sunlapackinttype* ipiv, sunlapackinttype* info);

extern void dgetrs_f77(const char* trans, const sunlapackinttype* n,
                       const sunlapackinttype* nrhs, double* a,
                       const sunlapackinttype* lda, sunlapackinttype* ipiv, double* b,
                       const sunlapackinttype* ldb, sunlapackinttype* info);

extern void dgeev_f77(const char* jobvl, const char* jobvr, const sunlapackinttype* n,
                      double* a, const sunlapackinttype* lda, double* wr, double* wi,
                      double* vl, const sunlapackinttype* ldvl, double* vr,
                      const sunlapackinttype* ldvr, double* work,
                      const sunlapackinttype* lwork, sunlapackinttype* info);

extern void sgbtrf_f77(const sunlapackinttype* m, const sunlapackinttype* n,
                       const sunlapackinttype* kl, const sunlapackinttype* ku,
                       float* ab, sunlapackinttype* ldab, sunlapackinttype* ipiv,
                       sunlapackinttype* info);

extern void sgbtrs_f77(const char* trans, const sunlapackinttype* n,
                       const sunlapackinttype* kl, const sunlapackinttype* ku,
                       const sunlapackinttype* nrhs, float* ab,
                       const sunlapackinttype* ldab, sunlapackinttype* ipiv, float* b,
                       const sunlapackinttype* ldb, sunlapackinttype* info);

extern void sgetrf_f77(const sunlapackinttype* m, const sunlapackinttype* n, float* a,
                       sunlapackinttype* lda, sunlapackinttype* ipiv, sunlapackinttype* info);

extern void sgetrs_f77(const char* trans, const sunlapackinttype* n,
                       const sunlapackinttype* nrhs, float* a,
                       const sunlapackinttype* lda, sunlapackinttype* ipiv, float* b,
                       const sunlapackinttype* ldb, sunlapackinttype* info);

extern void sgeev_f77(const char* jobvl, const char* jobvr, const sunlapackinttype* n,
                      float* a, const sunlapackinttype* lda, float* wr, float* wi,
                      float* vl, const sunlapackinttype* ldvl, float* vr,
                      const sunlapackinttype* ldvr, float* work,
                      const sunlapackinttype* lwork, sunlapackinttype* info);

#ifdef __cplusplus
}
#endif

#endif
