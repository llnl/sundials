# -----------------------------------------------------------------
# CMakeLists.txt for installed CVODE C++ examples.
# -----------------------------------------------------------------
cmake_minimum_required(VERSION @CMAKE_VERSION@)
project(cvode_cpp_examples CXX @CVODE_CPP_LANGUAGES@)

include(CTest)
set(SUNDIALS_DIR
    "@CMAKE_INSTALL_PREFIX@/@SUNDIALS_INSTALL_CMAKEDIR@"
    CACHE PATH "Location of SUNDIALSConfig.cmake")
find_package(SUNDIALS REQUIRED COMPONENTS @CVODE_CPP_COMPONENTS@
             HINTS "${SUNDIALS_DIR}" NO_DEFAULT_PATH)
@CVODE_CPP_FIND_MPI@

set(SUNDIALS_ENABLE_EXAMPLES_INSTALL OFF)
set(SUNDIALS_ENABLE_PACKAGE_FUSED_KERNELS @SUNDIALS_ENABLE_PACKAGE_FUSED_KERNELS@)
set(SUNDIALS_ENABLE_MPI @SUNDIALS_ENABLE_MPI@)
set(SUNDIALS_ENABLE_HYPRE @SUNDIALS_ENABLE_HYPRE@)
set(SUNDIALS_ENABLE_SUPERLUDIST @SUNDIALS_ENABLE_SUPERLUDIST@)
set(SUNDIALS_ENABLE_MAGMA @SUNDIALS_ENABLE_MAGMA@)
set(SUNDIALS_ENABLE_GINKGO @SUNDIALS_ENABLE_GINKGO@)
set(SUNDIALS_ENABLE_SUNLINSOL_KOKKOSDENSE @SUNDIALS_ENABLE_SUNLINSOL_KOKKOSDENSE@)
set(SUNDIALS_ENABLE_SUNLINSOL_ONEMKLDENSE @SUNDIALS_ENABLE_SUNLINSOL_ONEMKLDENSE@)
set(SUNDIALS_ENABLE_RAJA @SUNDIALS_ENABLE_RAJA@)
set(SUNDIALS_GINKGO_BACKENDS "@SUNDIALS_GINKGO_BACKENDS@")
set(KOKKOS_EXAMPLES_BACKENDS "@KOKKOS_EXAMPLES_BACKENDS@")
set(SUNDIALS_MAGMA_BACKENDS "@SUNDIALS_MAGMA_BACKENDS@")
set(SUNDIALS_RAJA_BACKENDS "@SUNDIALS_RAJA_BACKENDS@")
set(RAJA_BACKENDS "@RAJA_BACKENDS@")
set(EXE_EXTRA_LINK_LIBS "@EXE_EXTRA_LINK_LIBS@")

# The in-tree example CMake files use these wrappers.  Keeping the wrappers
# here lets the installed source CMake files be reused without depending on
# the SUNDIALS build-tree macros.
function(sundials_add_executable name)
  add_executable(${name} ${ARGN})
endfunction()

function(sundials_add_test name executable)
  set(options NODIFF)
  set(oneValueArgs MPI_NPROCS FLOAT_PRECISION INTEGER_PRECISION ANSWER_DIR
                   ANSWER_FILE EXAMPLE_TYPE)
  set(multiValueArgs TEST_ARGS EXTRA_ARGS LABELS)
  cmake_parse_arguments(arg "${options}" "${oneValueArgs}" "${multiValueArgs}"
                        ${ARGN})
  if(arg_MPI_NPROCS)
    add_test(NAME ${name}
             COMMAND ${MPIEXEC_EXECUTABLE} ${MPIEXEC_NUMPROC_FLAG}
                     ${arg_MPI_NPROCS} $<TARGET_FILE:${executable}>
                     ${arg_TEST_ARGS} ${arg_EXTRA_ARGS})
  else()
    add_test(NAME ${name} COMMAND $<TARGET_FILE:${executable}>
             ${arg_TEST_ARGS} ${arg_EXTRA_ARGS})
  endif()
  if(arg_LABELS)
    set_tests_properties(${name} PROPERTIES LABELS "${arg_LABELS}")
  endif()
endfunction()

macro(sundials_add_examples_ginkgo examples_var)
  set(options UNIT_TEST)
  set(oneValueArgs)
  set(multiValueArgs TARGETS BACKENDS)
  cmake_parse_arguments(ginkgo "${options}" "${oneValueArgs}"
                        "${multiValueArgs}" ${ARGN})
  foreach(example_tuple ${${examples_var}})
    list(GET example_tuple 0 example)
    list(GET example_tuple 1 example_args)
    list(GET example_tuple 2 example_type)
    foreach(backend ${ginkgo_BACKENDS})
      if(NOT (SUNDIALS_GINKGO_BACKENDS MATCHES "${backend}"))
        continue()
      endif()
      if(backend MATCHES "CUDA")
        set(vector nveccuda)
        set_source_files_properties(${example} PROPERTIES LANGUAGE CUDA)
      elseif(backend MATCHES "HIP")
        set(vector nvechip)
      elseif(backend MATCHES "SYCL")
        set(vector nvecsycl)
      elseif(backend MATCHES "OMP")
        set(vector nvecopenmp)
      else()
        set(vector nvecserial)
      endif()
      get_filename_component(example_target ${example} NAME_WE)
      set(example_target "${example_target}.${backend}")
      add_executable(${example_target} ${example})
      target_compile_definitions(${example_target} PRIVATE USE_${backend})
      target_include_directories(${example_target} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
      target_link_libraries(${example_target} PRIVATE ${ginkgo_TARGETS}
                            sundials_${vector} Ginkgo::ginkgo)
      if(example_args STREQUAL "")
        set(test_name ${example_target})
      else()
        string(REPLACE " " "_" test_name "${example_target}_${example_args}")
      endif()
      sundials_add_test(${test_name} ${example_target} TEST_ARGS ${example_args})
    endforeach()
  endforeach()
endmacro()

