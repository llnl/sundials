# -----------------------------------------------------------------
# CMakeLists.txt for installed CVODE C examples.
# -----------------------------------------------------------------
cmake_minimum_required(VERSION @CMAKE_VERSION@)
project(cvode_c_examples C)

include(CTest)
set(SUNDIALS_DIR
    "@CMAKE_INSTALL_PREFIX@/@SUNDIALS_INSTALL_CMAKEDIR@"
    CACHE PATH "Location of SUNDIALSConfig.cmake")
find_package(SUNDIALS REQUIRED COMPONENTS @CVODE_C_COMPONENTS_STRING@
             HINTS "${SUNDIALS_DIR}" NO_DEFAULT_PATH)
@CVODE_C_FIND_MPI@

set(SUNDIALS_ENABLE_EXAMPLES_INSTALL OFF)
set(SUNDIALS_ENABLE_PACKAGE_FUSED_KERNELS @SUNDIALS_ENABLE_PACKAGE_FUSED_KERNELS@)
set(SUNDIALS_ENABLE_MONITORING @SUNDIALS_ENABLE_MONITORING@)
set(SUNDIALS_ENABLE_MPI @SUNDIALS_ENABLE_MPI@)
set(SUNDIALS_ENABLE_HYPRE @SUNDIALS_ENABLE_HYPRE@)
set(SUNDIALS_ENABLE_PETSC @SUNDIALS_ENABLE_PETSC@)
set(SUNDIALS_ENABLE_OPENMP @SUNDIALS_ENABLE_OPENMP@)
set(SUNDIALS_ENABLE_OPENMP_DEVICE @SUNDIALS_ENABLE_OPENMP_DEVICE@)
set(OPENMP_SUPPORTS_DEVICE_OFFLOADING @OPENMP_SUPPORTS_DEVICE_OFFLOADING@)
set(SUNDIALS_ENABLE_NVECTOR_MPIMANYVECTOR @SUNDIALS_ENABLE_NVECTOR_MPIMANYVECTOR@)
set(SUNDIALS_ENABLE_SUNLINSOL_LAPACKBAND @SUNDIALS_ENABLE_SUNLINSOL_LAPACKBAND@)
set(SUNDIALS_ENABLE_SUNLINSOL_LAPACKDENSE @SUNDIALS_ENABLE_SUNLINSOL_LAPACKDENSE@)
set(SUNDIALS_ENABLE_SUNLINSOL_KLU @SUNDIALS_ENABLE_SUNLINSOL_KLU@)
set(SUNDIALS_ENABLE_SUNLINSOL_SUPERLUMT @SUNDIALS_ENABLE_SUNLINSOL_SUPERLUMT@)
set(SUNDIALS_INDEX_SIZE @SUNDIALS_INDEX_SIZE@)
set(EXE_EXTRA_LINK_LIBS "@EXE_EXTRA_LINK_LIBS@")
set(SUPERLUMT_LIBRARIES "@SUPERLUMT_LIBRARIES@")

function(sundials_add_executable name)
  add_executable(${name} ${ARGN})
endfunction()

function(sundials_add_test name executable)
  set(options NODIFF)
  set(oneValueArgs MPI_NPROCS FLOAT_PRECISION INTEGER_PRECISION ANSWER_DIR
                   ANSWER_FILE EXAMPLE_TYPE)
  set(multiValueArgs TEST_ARGS EXTRA_ARGS LABELS)
  cmake_parse_arguments(arg "${options}" "${oneValueArgs}" "${multiValueArgs}"
                        ${ARGN})
  if(arg_MPI_NPROCS)
    add_test(NAME ${name}
             COMMAND ${MPIEXEC_EXECUTABLE} ${MPIEXEC_NUMPROC_FLAG}
                     ${arg_MPI_NPROCS} $<TARGET_FILE:${executable}>
                     ${arg_TEST_ARGS} ${arg_EXTRA_ARGS})
  else()
    add_test(NAME ${name} COMMAND $<TARGET_FILE:${executable}>
             ${arg_TEST_ARGS} ${arg_EXTRA_ARGS})
  endif()
  if(arg_LABELS)
    set_tests_properties(${name} PROPERTIES LABELS "${arg_LABELS}")
  endif()
endfunction()

